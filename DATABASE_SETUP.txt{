}

function createTicket(ticketData) {
  const tickets = ticketsData.loadTickets();
  const newTicket = {
    id: tickets.length + 1,
    ...ticketData,
    prioridad: calculatePriority(...),
    fechaCreacion: new Date()
  };
  tickets.push(newTicket);
  ticketsData.saveTickets(tickets);
  return newTicket;
}
```

